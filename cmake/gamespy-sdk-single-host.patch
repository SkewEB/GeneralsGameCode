diff --git a/src/common/gsplatformsocket.c b/src/common/gsplatformsocket.c
index 2239795..695f988 100644
--- a/src/common/gsplatformsocket.c
+++ b/src/common/gsplatformsocket.c
@@ -652,6 +652,25 @@ gsi_u32 gsiGetBroadcastIP(void)
 ///////////////////////////////////////////////////////////////////////////////
 ///////////////////////////////////////////////////////////////////////////////
 
+#if defined(GSI_SINGLE_HOST) && defined(_WIN32) && !defined(_XBOX)
+// Map "<anything>." GSI_DOMAIN_NAME onto GSI_DOMAIN_NAME, then do the real lookup.
+#undef gethostbyname
+struct hostent* gsiSingleHostLookup(const char* name)
+{
+    static const char domain[] = GSI_DOMAIN_NAME;
+    const size_t domainLen = sizeof(domain) - 1;
+    size_t nameLen;
+
+    if (name != NULL) {
+        nameLen = strlen(name);
+        if (nameLen > domainLen + 1 && name[nameLen - domainLen - 1] == '.' &&
+            _stricmp(name + nameLen - domainLen, domain) == 0)
+            name = domain;
+    }
+    return gethostbyname(name);
+}
+#endif
+
