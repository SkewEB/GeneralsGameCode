@@ -65,6 +65,13 @@ if(GAMESPY_SERVER_NAME)
     message(STATUS "GameSpy server name is set to ${GAMESPY_SERVER_NAME}")
 endif()
 
+# Resolve every <service>.GSI_DOMAIN_NAME host to GSI_DOMAIN_NAME itself, so a
+# private server only needs a single DNS record instead of a wildcard.
+if(GAMESPY_SINGLE_HOST)
+    add_definitions(-DGSI_SINGLE_HOST)
+    message(STATUS "GameSpy services resolve to the single host ${GAMESPY_SERVER_NAME}")
+endif()
+
 list(APPEND GS_COMPILE_DEFS GS_PEER)
 
 if(GS_WINSOCK2)
